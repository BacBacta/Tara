# --- Base de données ---
# Dev local : SQLite. Prod : PostgreSQL (ex: postgresql://user:pass@host:5432/bioshop)
DATABASE_URL="file:./dev.db"

# --- Application ---
# URL publique du site (utilisée pour les liens absolus, OG tags, QR codes)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Sessions (32+ caractères aléatoires) ---
SESSION_SECRET="change-me-32-characters-minimum-secret"

# --- Pixel TikTok (vide = désactivé) ---
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# --- Fournisseurs (mock en V1 ; clés réelles au branchement de l'agrégateur) ---
PAYMENT_PROVIDER="mock"        # mock | simiz | camerpay
OTP_PROVIDER="mock"            # mock | whatsapp_bsp
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# Auto-confirmation du paiement mock apres ~6s (demo/dev uniquement)
PAYMENT_MOCK_AUTOCONFIRM="1"

# --- V2 : intégrations TikTok ---
TIKTOK_PROVIDER="mock"           # mock | real
TIKTOK_CLIENT_KEY=""             # Login Kit (portail TikTok for Developers)
TIKTOK_CLIENT_SECRET=""
TIKTOK_WEBHOOK_SECRET=""         # verification des webhooks TikTok
NOTIFY_PROVIDER="mock"           # mock | whatsapp_bsp
