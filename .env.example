# --- Base de données ---
# Le dialecte se déduit de l'URL :
#   file:./dev.db                                  → SQLite (développement)
#   postgresql://user:pass@host:5432/tara          → PostgreSQL (production)
# Le code métier est identique dans les deux cas.
DATABASE_URL="file:./dev.db"

# Taille du pool de connexions PostgreSQL (ignoré en SQLite).
DATABASE_POOL_MAX="10"

# --- Application ---
# URL publique du site (utilisée pour les liens absolus, OG tags, QR codes)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Sessions (32+ caractères aléatoires) ---
SESSION_SECRET="change-me-32-characters-minimum-secret"

# --- Stockage des photos d'articles ---
# disk        : public/uploads/ — developpement et VPS (disque inscriptible)
# vercel_blob : Vercel Blob — OBLIGATOIRE en serverless, ou les photos sont
#               perdues (systeme de fichiers en lecture seule)
STORAGE_PROVIDER="disk"
# Fourni automatiquement par Vercel quand un store Blob est attache au projet.
BLOB_READ_WRITE_TOKEN=""

# --- Pixel TikTok (vide = désactivé) ---
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# --- Fournisseurs (mock en V1 ; clés réelles au branchement de l'agrégateur) ---
PAYMENT_PROVIDER="mock"        # mock | simiz | camerpay
# L'OTP réel délègue au canal de notifications (NOTIFY_PROVIDER) :
# « whatsapp » et « sms » nomment l'intention, le canal effectif est celui
# de NOTIFY_PROVIDER. Production : "whatsapp".
OTP_PROVIDER="mock"            # mock | whatsapp | sms
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# Auto-confirmation du paiement mock apres ~6s (demo/dev uniquement)
PAYMENT_MOCK_AUTOCONFIRM="1"

# --- V2 : intégrations TikTok ---
TIKTOK_PROVIDER="mock"           # mock | real
TIKTOK_CLIENT_KEY=""             # Login Kit (portail TikTok for Developers)
TIKTOK_CLIENT_SECRET=""
TIKTOK_WEBHOOK_SECRET=""         # verification des webhooks TikTok
# --- Notifications (OTP, avis, annonces, alertes de drop) ---
# mock          : journalise, n'envoie rien (dev/demo)
# whatsapp_cloud: API Meta directe — CHEMIN DE PRODUCTION (decision 2026-08-28)
# sms           : passerelle SMS locale — repli si la verification Meta traine
NOTIFY_PROVIDER="mock"

# WhatsApp Cloud API — societe verifiee par Meta, numero dedie, et les CINQ
# templates approuves (otp, new_video_tag, review_request, shop_announcement,
# drop_open), chacun dans sa categorie (voir src/lib/notify.ts).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_LANG="fr"      # langue des templates approuves
WHATSAPP_TEMPLATE_PREFIX=""      # prefixe si le WABA impose un espace de noms
WHATSAPP_API_VERSION="v21.0"     # version de l'API Graph

# Passerelle SMS camerounaise (repli : facturation en FCFA, aucun dossier Meta)
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="TARA"

# --- Abonnement des vendeuses (3 000 F/mois — la seule recette de Tara) ---
# Tant qu'aucun agregateur n'est branche (PAYMENT_PROVIDER=mock ou vide), la
# vendeuse ne peut pas payer dans l'application : l'ecran d'abonnement lui
# donne le portefeuille MoMo de Tara, et l'activation se fait a la main
# depuis /admin (encaissement manuel, avec la reference du versement).
# Sans ce numero, elle n'a AUCUN moyen de payer : le pre-vol bloque.
TARA_MOMO_NUMBER=""              # portefeuille MoMo de Tara (ex : 6XXXXXXXX)
TARA_MOMO_OPERATOR="mtn"         # mtn | orange
TARA_WHATSAPP=""                 # numero WhatsApp de Tara, pour la prevenir
